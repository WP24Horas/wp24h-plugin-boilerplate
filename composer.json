{
  "name": "wp24horas/wp24h-plugin-boilerplate",
  "description": "A modular, configurable and production-ready WordPress plugin starter.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.5 || ^7.0",
    "phpstan/phpstan": "^1.12 || ^2.0",
    "phpunit/phpunit": "^10.5",
    "szepeviktor/phpstan-wordpress": "^1.3 || ^2.0",
    "squizlabs/php_codesniffer": "^3.11",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "WP24H\\PluginBoilerplate\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WP24H\\PluginBoilerplate\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=512M",
    "test": "phpunit",
    "tooling:lint": "php scripts/lint-tooling.php",
    "tooling:hardening": "php scripts/check-generator-hardening.php",
    "make:module": "php bin/wp24h-make-module",
    "scaffold": "php bin/wp24h-init",
    "scaffold:smoke": "php scripts/smoke-scaffold.php",
    "scaffold:smoke:full": "php scripts/smoke-scaffold.php --full",
    "release:build": "bash scripts/build-release.sh",
    "release:verify": "bash scripts/verify-release.sh",
    "release:package": [
      "@release:build",
      "@release:verify"
    ],
    "check": [
      "@lint",
      "@analyse",
      "@test",
      "@tooling:lint",
      "@tooling:hardening"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
