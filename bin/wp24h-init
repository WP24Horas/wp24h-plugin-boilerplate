#!/usr/bin/env php
<?php

declare(strict_types=1);

const SOURCE_SLUG = 'wp24h-plugin-boilerplate';
const SOURCE_REST_BASE = 'wp24h-boilerplate';
const SOURCE_SNAKE = 'wp24h_plugin_boilerplate';
const SOURCE_NAME = 'WP24H Plugin Boilerplate';
const SOURCE_SHORT_NAME = 'WP24H Boilerplate';
const SOURCE_NAMESPACE = 'WP24H\\PluginBoilerplate';
const SOURCE_PREFIX = 'WP24H_PLUGIN_BOILERPLATE';
const SOURCE_PACKAGE = 'wp24horas/wp24h-plugin-boilerplate';

$options = getopt('', [
    'name:',
    'slug:',
    'namespace:',
    'vendor::',
    'author::',
    'author-uri::',
    'plugin-uri::',
    'target:',
    'help',
]);

if (isset($options['help'])) {
    usage(0);
}

$name = trim((string) ($options['name'] ?? ''));
$slug = trim((string) ($options['slug'] ?? ''));
$namespace = trim((string) ($options['namespace'] ?? ''));
$vendor = trim((string) ($options['vendor'] ?? ''));
$author = trim((string) ($options['author'] ?? ''));
$authorUri = trim((string) ($options['author-uri'] ?? ''));
$pluginUri = trim((string) ($options['plugin-uri'] ?? ''));
$target = trim((string) ($options['target'] ?? ''));

$errors = [];

if ($name === '') {
    $errors[] = '--name is required.';
}

if (!preg_match('/^[a-z0-9]+(?:-[a-z0-9]+)*$/', $slug)) {
    $errors[] = '--slug must use lowercase kebab-case (example: acme-orders).';
}

if (!preg_match('/^[A-Z][A-Za-z0-9]*(?:\\\\[A-Z][A-Za-z0-9]*)+$/', $namespace)) {
    $errors[] = '--namespace must be a PSR-4 style namespace with at least two segments (example: Acme\\Orders).';
}

if ($target === '') {
    $errors[] = '--target is required.';
}

if ($vendor === '') {
    $vendor = strtolower((string) preg_replace('/[^a-z0-9]+/i', '-', strtok($namespace, '\\') ?: 'plugin'));
}

if (!preg_match('/^[a-z0-9]+(?:-[a-z0-9]+)*$/', $vendor)) {
    $errors[] = '--vendor must use lowercase Composer vendor syntax.';
}

foreach (['--author-uri' => $authorUri, '--plugin-uri' => $pluginUri] as $label => $uri) {
    if ($uri !== '' && filter_var($uri, FILTER_VALIDATE_URL) === false) {
        $errors[] = $label . ' must be a valid URL.';
    }
}

if ($errors !== []) {
    foreach ($errors as $error) {
        fwrite(STDERR, "Error: {$error}\n");
    }
    usage(1);
}

$root = dirname(__DIR__);
$targetPath = absolutePath($target);

if (file_exists($targetPath)) {
    fwrite(STDERR, "Error: target already exists: {$targetPath}\n");
    exit(1);
}

if (!mkdir($targetPath, 0775, true) && !is_dir($targetPath)) {
    fwrite(STDERR, "Error: could not create target: {$targetPath}\n");
    exit(1);
}

$snake = str_replace('-', '_', $slug);
$prefix = strtoupper($snake);
$package = $vendor . '/' . $slug;
$escapedSourceNamespace = str_replace('\\', '\\\\', SOURCE_NAMESPACE);
$escapedTargetNamespace = str_replace('\\', '\\\\', $namespace);

$replacements = [
    SOURCE_PACKAGE => $package,
    $escapedSourceNamespace => $escapedTargetNamespace,
    SOURCE_NAMESPACE => $namespace,
    SOURCE_PREFIX => $prefix,
    SOURCE_SNAKE => $snake,
    SOURCE_SLUG => $slug,
    SOURCE_REST_BASE => $slug,
    SOURCE_NAME => $name,
    SOURCE_SHORT_NAME => $name,
];

if ($author !== '') {
    $replacements['Author:      WP24Horas'] = 'Author:      ' . $author;
}

if ($authorUri !== '') {
    $replacements['Author URI:  https://wp24horas.com.br'] = 'Author URI:  ' . $authorUri;
}

$excludedTopLevel = [
    '.git',
    'vendor',
    'dist',
    'composer.lock',
];

try {
    copyTree($root, $targetPath, $root, $replacements, $excludedTopLevel);

    $oldMain = $targetPath . DIRECTORY_SEPARATOR . SOURCE_SLUG . '.php';
    $newMain = $targetPath . DIRECTORY_SEPARATOR . $slug . '.php';

    if (!is_file($oldMain) || !rename($oldMain, $newMain)) {
        throw new RuntimeException('Could not rename the main plugin file.');
    }

    normalizeGeneratedMainHeader($newMain, $pluginUri);

    $generatedScaffolder = $targetPath . DIRECTORY_SEPARATOR . 'bin' . DIRECTORY_SEPARATOR . 'wp24h-init';
    if (is_file($generatedScaffolder)) {
        unlink($generatedScaffolder);
    }

    $generatedSmoke = $targetPath . DIRECTORY_SEPARATOR . 'scripts' . DIRECTORY_SEPARATOR . 'smoke-scaffold.php';
    if (is_file($generatedSmoke)) {
        unlink($generatedSmoke);
    }

    $binDir = dirname($generatedScaffolder);
    if (is_dir($binDir) && directoryIsEmpty($binDir)) {
        rmdir($binDir);
    }

    $scaffoldingDoc = $targetPath . DIRECTORY_SEPARATOR . 'docs' . DIRECTORY_SEPARATOR . 'scaffolding.md';
    if (is_file($scaffoldingDoc)) {
        unlink($scaffoldingDoc);
    }

    cleanGeneratedComposer($targetPath);
    writeGeneratedReadme($targetPath, $name, $slug, $namespace, $package, $pluginUri);
    writeGeneratedWpOrgReadme($targetPath, $name);
    writeGeneratedChangelog($targetPath, $name);
    writeGeneratedSecurityPolicy($targetPath, $name, $authorUri, $pluginUri);

    fwrite(STDOUT, "Plugin scaffold created successfully.\n\n");
    fwrite(STDOUT, "Name:       {$name}\n");
    fwrite(STDOUT, "Slug:       {$slug}\n");
    fwrite(STDOUT, "Namespace:  {$namespace}\n");
    fwrite(STDOUT, "Package:    {$package}\n");
    fwrite(STDOUT, "Plugin URI: " . ($pluginUri !== '' ? $pluginUri : '(not set)') . "\n");
    fwrite(STDOUT, "Target:     {$targetPath}\n\n");
    fwrite(STDOUT, "Next steps:\n");
    fwrite(STDOUT, "  cd \"{$targetPath}\"\n");
    fwrite(STDOUT, "  composer install\n");
    fwrite(STDOUT, "  composer check\n");
} catch (Throwable $exception) {
    removeTree($targetPath);
    fwrite(STDERR, 'Error: ' . $exception->getMessage() . "\n");
    exit(1);
}

function usage(int $exitCode): never
{
    $script = basename(__FILE__);
    $message = <<<TXT
WP24H Plugin Boilerplate scaffolder

Usage:
  php bin/{$script} \\
    --name="Acme Orders" \\
    --slug=acme-orders \\
    --namespace="Acme\\Orders" \\
    --vendor=acme \\
    --author="Acme Inc." \\
    --author-uri="https://example.com" \\
    --plugin-uri="https://github.com/acme/acme-orders" \\
    --target="../acme-orders"

Required:
  --name         Human-readable plugin name.
  --slug         Lowercase kebab-case plugin slug/text domain.
  --namespace    PSR-4 namespace with at least two segments.
  --target       New directory to create. It must not already exist.

Optional:
  --vendor       Composer vendor. Defaults to the first namespace segment.
  --author       Replaces the default plugin author in the main header.
  --author-uri   Replaces the default author URL and may be referenced by the generated security policy.
  --plugin-uri   Explicit plugin/repository URL. If omitted, Plugin URI is removed from the generated header.
  --help         Show this help.

Safety:
  - never overwrites an existing target;
  - excludes .git, vendor, dist and the boilerplate composer.lock;
  - replaces kebab, snake, REST, namespace and constant identities deterministically;
  - never invents a WP24Horas repository URL for a generated plugin;
  - generates ownership-neutral README, readme.txt, changelog and security guidance;
  - removes scaffolder-only commands and tooling from the generated plugin;
  - removes a partial target if generation fails.
TXT;

    fwrite($exitCode === 0 ? STDOUT : STDERR, $message . "\n");
    exit($exitCode);
}

function absolutePath(string $path): string
{
    if (preg_match('/^(?:[A-Za-z]:[\\\\\/]|[\\\\\/])/', $path)) {
        return rtrim($path, "\\/ ");
    }

    return rtrim((getcwd() ?: '.') . DIRECTORY_SEPARATOR . $path, "\\/ ");
}

/**
 * @param array<string,string> $replacements
 * @param list<string> $excludedTopLevel
 */
function copyTree(
    string $source,
    string $target,
    string $root,
    array $replacements,
    array $excludedTopLevel
): void {
    $iterator = new DirectoryIterator($source);

    foreach ($iterator as $item) {
        if ($item->isDot()) {
            continue;
        }

        $path = $item->getPathname();
        $relative = ltrim(substr($path, strlen($root)), DIRECTORY_SEPARATOR);
        $topLevel = strtok(str_replace('\\', '/', $relative), '/');

        if (in_array($topLevel, $excludedTopLevel, true)) {
            continue;
        }

        $destination = $target . DIRECTORY_SEPARATOR . $relative;

        if ($item->isDir()) {
            if (!is_dir($destination) && !mkdir($destination, 0775, true) && !is_dir($destination)) {
                throw new RuntimeException("Could not create directory: {$destination}");
            }

            copyTree($path, $target, $root, $replacements, $excludedTopLevel);
            continue;
        }

        $parent = dirname($destination);
        if (!is_dir($parent) && !mkdir($parent, 0775, true) && !is_dir($parent)) {
            throw new RuntimeException("Could not create directory: {$parent}");
        }

        $contents = file_get_contents($path);
        if ($contents === false) {
            throw new RuntimeException("Could not read file: {$path}");
        }

        if (isTextFile($relative, $contents)) {
            $contents = str_replace(array_keys($replacements), array_values($replacements), $contents);
        }

        if (file_put_contents($destination, $contents) === false) {
            throw new RuntimeException("Could not write file: {$destination}");
        }
    }
}

function isTextFile(string $path, string $contents): bool
{
    $extension = strtolower(pathinfo($path, PATHINFO_EXTENSION));
    $textExtensions = [
        '', 'php', 'md', 'txt', 'json', 'xml', 'yml', 'yaml', 'dist', 'neon',
        'js', 'css', 'scss', 'pot', 'lock', 'sh', 'ps1',
    ];

    return in_array($extension, $textExtensions, true) && !str_contains($contents, "\0");
}

function normalizeGeneratedMainHeader(string $mainFile, string $pluginUri): void
{
    $contents = file_get_contents($mainFile);
    if ($contents === false) {
        throw new RuntimeException('Could not read generated main plugin file.');
    }

    if ($pluginUri === '') {
        $contents = (string) preg_replace('/^ \* Plugin URI:\s+.*\R/m', '', $contents);
    } else {
        $contents = (string) preg_replace('/^ \* Plugin URI:\s+.*$/m', ' * Plugin URI:  ' . $pluginUri, $contents);
    }

    if (file_put_contents($mainFile, $contents) === false) {
        throw new RuntimeException('Could not normalize generated plugin header.');
    }
}

function cleanGeneratedComposer(string $targetPath): void
{
    $composerPath = $targetPath . DIRECTORY_SEPARATOR . 'composer.json';
    $contents = file_get_contents($composerPath);
    if ($contents === false) {
        throw new RuntimeException('Could not read generated composer.json.');
    }

    $composer = json_decode($contents, true, 512, JSON_THROW_ON_ERROR);
    if (!is_array($composer)) {
        throw new RuntimeException('Generated composer.json is invalid.');
    }

    if (isset($composer['scripts']) && is_array($composer['scripts'])) {
        unset($composer['scripts']['scaffold'], $composer['scripts']['scaffold:smoke'], $composer['scripts']['scaffold:smoke:full']);
    }

    $json = json_encode($composer, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
    if (file_put_contents($composerPath, $json) === false) {
        throw new RuntimeException('Could not normalize generated composer.json.');
    }
}

function writeGeneratedReadme(
    string $targetPath,
    string $name,
    string $slug,
    string $namespace,
    string $package,
    string $pluginUri
): void {
    $projectLink = $pluginUri !== '' ? "\n- Project URL: {$pluginUri}" : '';
    $content = <<<MD
# {$name}

WordPress plugin generated from the [WP24H Plugin Boilerplate](https://github.com/WP24Horas/wp24h-plugin-boilerplate).

## Technical baseline

- Plugin slug / text domain: `{$slug}`
- PHP namespace: `{$namespace}`
- Composer package: `{$package}`{$projectLink}
- WordPress 6.5+
- PHP 8.1+
- PHPCS + WordPress Coding Standards
- PHPStan
- PHPUnit + Brain Monkey
- Optional local environment with `wp-env`

## Development

```bash
composer install
composer check
```

Review the example modules under `src/Modules/` and remove features that are not part of the real plugin before the first release.

## Documentation

- `docs/customization.md`
- `docs/module-api.md`
- `docs/releasing.md`
- `SECURITY.md`
- `CONTRIBUTING.md`

## License

GPL-2.0-or-later. Review the license and project metadata before distribution.
MD;

    if (file_put_contents($targetPath . DIRECTORY_SEPARATOR . 'README.md', $content . "\n") === false) {
        throw new RuntimeException('Could not write generated README.md.');
    }
}

function writeGeneratedWpOrgReadme(string $targetPath, string $name): void
{
    $content = <<<TXT
=== {$name} ===
Requires at least: 6.5
Tested up to: 7.0
Requires PHP: 8.1
Stable tag: 1.0.0
License: GPLv2 or later
License URI: https://www.gnu.org/licenses/gpl-2.0.html

WordPress plugin scaffold generated from WP24H Plugin Boilerplate. Replace this summary before the first public release.

== Description ==

This file is intentionally ownership-neutral. Replace this section with the real plugin description, supported workflows and user-facing behavior before submitting to WordPress.org.

The generated project includes a modular PHP architecture, development tooling, tests, static analysis and safe extension points inherited from the WP24H Plugin Boilerplate.

== Installation ==

1. Install the plugin directory in `wp-content/plugins`.
2. Run `composer install` when using the development tooling.
3. Run `composer check` before distribution.
4. Activate the plugin in WordPress.
5. Review and remove example modules that are not part of the final product.

== Changelog ==

= 1.0.0 =
* Initial scaffold. Replace this entry with the first real release notes before distribution.
TXT;

    if (file_put_contents($targetPath . DIRECTORY_SEPARATOR . 'readme.txt', $content . "\n") === false) {
        throw new RuntimeException('Could not write generated readme.txt.');
    }
}

function writeGeneratedChangelog(string $targetPath, string $name): void
{
    $content = <<<MD
# Changelog

All notable changes to {$name} will be documented in this file.

## [Unreleased]

### Added

- Initial project scaffold generated from WP24H Plugin Boilerplate.
MD;

    if (file_put_contents($targetPath . DIRECTORY_SEPARATOR . 'CHANGELOG.md', $content . "\n") === false) {
        throw new RuntimeException('Could not write generated CHANGELOG.md.');
    }
}

function writeGeneratedSecurityPolicy(
    string $targetPath,
    string $name,
    string $authorUri,
    string $pluginUri
): void {
    $contact = '';
    if ($pluginUri !== '') {
        $contact .= "\nIf this project enables GitHub private vulnerability reporting, use it instead of opening a public issue.";
    }
    if ($authorUri !== '') {
        $contact .= "\n\nMaintainer contact/homepage: <{$authorUri}>.";
    }

    $content = <<<MD
# Security policy

## Supported version

Security fixes target the latest maintained release of {$name}.

## Reporting a vulnerability

Do not disclose exploitable details in a public issue.{$contact}

Include enough information for maintainers to validate the report safely:

- affected version and environment;
- reproduction steps or proof of concept;
- expected impact;
- suggested remediation, if known.

Allow reasonable time for validation and coordinated disclosure.

This file was generated without assuming that the project is owned or maintained by WP24Horas. Update the contact channel before the first public release.
MD;

    if (file_put_contents($targetPath . DIRECTORY_SEPARATOR . 'SECURITY.md', $content . "\n") === false) {
        throw new RuntimeException('Could not write generated SECURITY.md.');
    }
}

function directoryIsEmpty(string $directory): bool
{
    $entries = scandir($directory);
    return $entries !== false && count($entries) === 2;
}

function removeTree(string $path): void
{
    if (!file_exists($path)) {
        return;
    }

    if (is_file($path) || is_link($path)) {
        unlink($path);
        return;
    }

    foreach (new DirectoryIterator($path) as $item) {
        if ($item->isDot()) {
            continue;
        }
        removeTree($item->getPathname());
    }

    rmdir($path);
}
