<?xml version="1.0"?>
<ruleset name="WP24H Plugin Boilerplate">
	<description>WordPress coding standards for the WP24H Plugin Boilerplate.</description>

	<file>wp24h-plugin-boilerplate.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>tests</file>

	<exclude-pattern>vendor/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress-Core">
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<config name="minimum_supported_wp_version" value="6.5"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp24h-plugin-boilerplate"/>
			</property>
		</properties>
	</rule>
</ruleset>
